# ================================================================
# Carbon Footprint Awareness Platform — Environment Variables
# ================================================================
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# All secrets should be stored in Google Cloud Secret Manager
# and injected at Cloud Run runtime.
#
# Prefix rules:
#   NEXT_PUBLIC_*  → Exposed to the browser (client-safe only)
#   No prefix      → Server-side only (never sent to browser)
# ================================================================

# ────────────────────────────────────────────────────────────────
# FIREBASE — Client SDK (safe to expose publicly)
# ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push VAPID key — from Firebase Console > Project Settings > Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ────────────────────────────────────────────────────────────────
# FIREBASE — Admin SDK (server-side only, store in Secret Manager)
# ────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key including -----BEGIN/END----- lines
FIREBASE_PRIVATE_KEY=

# ────────────────────────────────────────────────────────────────
# GOOGLE MAPS PLATFORM
# ────────────────────────────────────────────────────────────────
# Server-side key: Routes API, Geocoding API, Air Quality API
# Restrict to Cloud Run service account in GCP Console
GOOGLE_MAPS_API_KEY=
# Client-side key: Maps JavaScript SDK (restrict to your domain)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ────────────────────────────────────────────────────────────────
# GEMINI API
# ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Model to use for emission calculation coaching and weekly digest
GEMINI_MODEL=gemini-2.0-flash

# ────────────────────────────────────────────────────────────────
# GOOGLE CLOUD
# ────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
# Cloud Storage bucket names (without gs:// prefix)
GCS_BUCKET_AVATARS=
GCS_BUCKET_EXPORTS=

# ────────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL
# ────────────────────────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql://carbon_user:carbon_pass@localhost:5432/carbon_db
# Cloud Run (via Cloud SQL Auth Proxy socket):
# DATABASE_URL=postgresql://carbon_user:carbon_pass@/carbon_db?host=/cloudsql/PROJECT:REGION:INSTANCE

# ────────────────────────────────────────────────────────────────
# EXTERNAL EMISSION API
# ────────────────────────────────────────────────────────────────
# Climatiq API — https://www.climatiq.io
CLIMATIQ_API_KEY=

# ────────────────────────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Backend API base URL (used by frontend API client)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal secret for Cloud Scheduler → backend cron endpoint auth
CRON_SECRET=change-this-to-a-random-32-char-string
